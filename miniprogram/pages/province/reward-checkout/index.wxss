/* 确认订单 */

.checkout-page {
  min-height: 100vh;
  background: #FEFAF8;
  display: flex;
  flex-direction: column;
}

.checkout-scroll {
  flex: 1;
  padding: 24rpx;
}

/* 订单列表 */
.order-list { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 24rpx; }

.order-item { display: flex; align-items: center; gap: 16rpx; background: #FFFFFF; border-radius: 16rpx; padding: 20rpx; }

.order-img { width: 100rpx; height: 100rpx; border-radius: 12rpx; flex-shrink: 0; }

.order-img-fb {
  width: 100rpx; height: 100rpx; border-radius: 12rpx; flex-shrink: 0;
  background: #F5F0EB; display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}

.order-info { flex: 1; }

.order-name { font-size: 28rpx; font-weight: 600; color: #1A1412; margin-bottom: 4rpx; }

.order-qty { font-size: 22rpx; color: #9E8A82; }

.order-subtotal { font-size: 26rpx; font-weight: 600; color: #C8A96E; flex-shrink: 0; }

/* 卡片区 */
.card-section { background: #FFFFFF; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }

.card-title { font-size: 28rpx; font-weight: 600; color: #1A1412; margin-bottom: 16rpx; }

/* 地址输入 */
.addr-row { display: flex; gap: 16rpx; margin-bottom: 12rpx; }

.addr-input {
  flex: 1; padding: 14rpx 16rpx; border-radius: 12rpx;
  border: 1rpx solid #E0D5CE; font-size: 26rpx; background: #FAF7F5;
}

.addr-input-full {
  width: 100%; padding: 14rpx 16rpx; border-radius: 12rpx;
  border: 1rpx solid #E0D5CE; font-size: 26rpx; background: #FAF7F5;
  margin-bottom: 12rpx; box-sizing: border-box;
}

/* 汇总 */
.summary-row { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 0; }

.summary-label { font-size: 26rpx; color: #4A3A34; }

.summary-value { font-size: 26rpx; color: #4A3A34; }

.summary-divider { height: 1rpx; background: #EDE6E2; margin: 12rpx 0; }

.summary-total { font-size: 36rpx; font-weight: 700; color: #C8A96E; }

/* 提交 */
.submit-area {
  padding: 20rpx 24rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF; border-top: 1rpx solid #EDE6E2; flex-shrink: 0;
}

.submit-btn {
  width: 100%; padding: 24rpx; background: linear-gradient(135deg, #5C1A1A, #7A2828);
  color: #FFFFFF; font-size: 32rpx; font-weight: 600; border-radius: 16rpx; text-align: center;
}

.submit-btn.disabled { opacity: 0.5; }
