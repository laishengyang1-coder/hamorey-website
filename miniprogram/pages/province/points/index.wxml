<wxs src="/utils/format.wxs" module="fmt" />
<view class="page-container">
<nav-bar title="积分管理" backUrl="/pages/province/index/index" />
  <!-- 红色头部 -->
  <view class="points-hero">
    <view class="points-hero-balance">
      <view class="points-hero-label">可用积分</view>
      <view class="points-hero-value">{{points ? points.available : '—'}}</view>
    </view>
    <view class="points-hero-row">
      <view class="points-hero-item">
        <text class="points-hero-item-label">冻结积分</text>
        <text class="points-hero-item-value">{{points ? points.frozen : '—'}}</text>
      </view>
      <view class="points-hero-item">
        <text class="points-hero-item-label">账户总积分</text>
        <text class="points-hero-item-value">{{points ? points.available + points.frozen : '—'}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-row">
    <view class="quick-btn" bindtap="goRewards">
      <view class="quick-btn-icon quick-btn-icon-rewards">🛍️</view>
      <text class="quick-btn-text">积分商城</text>
    </view>
    <view class="quick-btn" bindtap="goOrders">
      <view class="quick-btn-icon quick-btn-icon-orders">📋</view>
      <text class="quick-btn-text">兑换记录</text>
    </view>
  </view>

  <!-- 积分流水 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">积分流水</view>
    </view>

    <!-- Loading / Empty / List -->
    <view wx:if="{{loading}}" class="loading-container" style="padding:80rpx"><view class="loading-spinner"></view></view>
    <view wx:elif="{{error}}" class="empty-state">
      <view class="empty-state-text">{{error}}</view>
      <button size="mini" bindtap="retryPage">重试</button>
    </view>
    <view wx:elif="{{ledger.length === 0}}" class="empty-state" style="padding:60rpx">
      <view class="empty-state-text">暂无积分记录</view>
    </view>
    <view wx:else class="section-body">
      <view class="ledger-item" wx:for="{{ledger}}" wx:key="id">
        <view class="ledger-info">
          <view class="ledger-desc">{{item.reason || fmt.ledger(item.change_type)}}</view>
          <view class="ledger-time">{{fmt.dateTime(item.created_at)}}</view>
        </view>
        <view class="ledger-amount">
          <view wx:if="{{item.availableDelta || !item.frozenDelta}}" class="{{item.availableDelta > 0 ? 'text-success' : ''}}">可用 {{item.availableText}}</view>
          <view wx:if="{{item.frozenDelta}}">冻结 {{item.frozenText}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{!loading && !error && pages > 1}}" class="ledger-pagination">
      <button size="mini" disabled="{{page <= 1}}" bindtap="previousPage">上一页</button>
      <text>{{page}} / {{pages}} 页 · 共 {{total}} 条</text>
      <button size="mini" disabled="{{page >= pages}}" bindtap="nextPage">下一页</button>
    </view>
  </view>
</view>
<custom-tab-bar/>
