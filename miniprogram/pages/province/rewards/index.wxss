/* 积分商城 — 对齐我的积分风格 */

.page-container { min-height: 100vh; background: #FEFAF8; padding-bottom: 140rpx; }

/* 积分条 */
.points-strip { background: linear-gradient(135deg, #5C1A1A, #7A2828); padding: 16rpx 32rpx; display: flex; justify-content: space-between; align-items: baseline; }

.points-strip-label { font-size: 24rpx; color: rgba(255,255,255,0.6); }

.points-strip-value { font-size: 36rpx; font-weight: 700; color: #FFFFFF; }

/* Loading / Error / Empty */
.loading-wrap, .error-wrap, .empty-wrap { padding: 160rpx 32rpx; text-align: center; }

.loading-spinner { width: 48rpx; height: 48rpx; border: 4rpx solid #E8E0DC; border-top-color: #5C1A1A; border-radius: 50%; animation: spin .8s linear infinite; margin: 0 auto; }
@keyframes spin { to { transform: rotate(360deg); } }

.error-text, .empty-text { font-size: 26rpx; color: #9E8A82; }

.retry-btn { display: inline-block; margin-top: 16rpx; padding: 10rpx 36rpx; background: #5C1A1A; color: #FFF; border-radius: 20rpx; font-size: 24rpx; }

/* 商品网格 */
.product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; padding: 20rpx 24rpx; }

.product-card { background: #FFFFFF; border-radius: 16rpx; overflow: hidden; }

.product-img-wrap { width: 100%; height: 280rpx; }

.product-img { width: 100%; height: 100%; }

.product-img-empty { width: 100%; height: 100%; background: #F5F0EB; display: flex; align-items: center; justify-content: center; font-size: 60rpx; }

.product-info { padding: 16rpx; }

.product-name { font-size: 26rpx; font-weight: 600; color: #1A1412; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 6rpx; }

.product-points { font-size: 24rpx; color: #C8A96E; font-weight: 600; margin-bottom: 4rpx; }

.product-stock { font-size: 20rpx; color: #9E8A82; margin-bottom: 8rpx; }

.product-sold { font-size: 22rpx; color: #D48888; font-weight: 600; margin-bottom: 8rpx; }

/* 数量选择 */
.qty-row { display: flex; align-items: center; gap: 12rpx; }

.qty-minus, .qty-plus { width: 44rpx; height: 44rpx; border-radius: 50%; background: #F5F0EB; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 600; color: #5C1A1A; }

.qty-minus.off { opacity: 0.25; }

.qty-val { font-size: 26rpx; font-weight: 600; color: #1A1412; min-width: 32rpx; text-align: center; }

/* 结算栏 */
.settle-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #FFFFFF; border-top: 1rpx solid #EDE6E2; padding: 16rpx 28rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); display: flex; justify-content: space-between; align-items: center; z-index: 20; box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.06); font-size: 24rpx; color: #4A3A34; }

.settle-pts { font-size: 28rpx; font-weight: 700; color: #C8A96E; }

.settle-btn { padding: 14rpx 40rpx; background: linear-gradient(135deg, #5C1A1A, #7A2828); color: #FFFFFF; font-size: 26rpx; font-weight: 600; border-radius: 28rpx; }
