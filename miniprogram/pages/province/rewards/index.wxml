<view class="page-container">
  <!-- 红色头部 -->
  <view class="rewards-hero">
    <view class="rewards-hero-title">积分商城</view>
    <view class="rewards-hero-points">
      <text class="rewards-hero-num">{{myPoints}}</text>
      <text class="rewards-hero-label">可用积分</text>
    </view>
  </view>

  <!-- Loading / Error / Empty -->
  <view wx:if="{{loading}}" class="loading-container"><view class="loading-spinner"></view></view>
  <view wx:elif="{{error}}" class="error-container">
    <view class="error-text">{{error}}</view>
    <view class="retry-btn" bindtap="loadRewards">重试</view>
  </view>
  <view wx:elif="{{!loading && rewards.length === 0}}" class="empty-state">
    <view class="empty-state-text">暂无兑换商品</view>
  </view>

  <!-- 商品双列网格 -->
  <view wx:else class="rewards-grid">
    <view class="reward-card" wx:for="{{rewards}}" wx:key="id">
      <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="reward-img" lazy-load />
      <view wx:else class="reward-img-fallback">🎁</view>
      <view class="reward-body">
        <view class="reward-name">{{item.name || '--'}}</view>
        <view class="reward-points">{{item.points_required || 0}} 积分</view>
        <view wx:if="{{item.stock_status !== 'out_of_stock' && item.stock_quantity > 0}}" class="reward-stock">库存 {{item.stock_quantity}}</view>
        <view wx:else class="reward-soldout">已售罄</view>
        <view class="qty-row" wx:if="{{item.stock_status !== 'out_of_stock' && item.stock_quantity > 0}}">
          <view class="qty-btn {{item.qty <= 0 ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="decQty">−</view>
          <view class="qty-num">{{item.qty || 0}}</view>
          <view class="qty-btn" data-id="{{item.id}}" bindtap="incQty">+</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="checkout-bar" wx:if="{{showCart}}">
    <view class="checkout-info">
      <view class="checkout-count">已选 {{cartCount}} 种商品</view>
      <view class="checkout-total"><text class="checkout-points">{{cartTotal}}</text> 积分</view>
    </view>
    <view class="checkout-btn" bindtap="goCheckout">去结算</view>
  </view>
</view>
<custom-tab-bar/>
