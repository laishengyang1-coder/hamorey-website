.page-container {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 160rpx;
}

/* 步骤指示器 */
.steps-bar {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 32rpx 48rpx;
  background: var(--color-bg-white);
  overflow-x: auto;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
  min-width: 100rpx;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-border);
  color: var(--color-text-light);
  font-size: var(--font-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.step-item.active .step-dot {
  background: var(--color-primary);
  color: #FFFFFF;
}

.step-item.done .step-dot {
  background: var(--color-success);
  color: #FFFFFF;
}

.step-label {
  font-size: 18rpx;
  color: var(--color-text-light);
  margin-top: 8rpx;
  white-space: nowrap;
}

.step-item.active .step-label {
  color: var(--color-primary);
  font-weight: 500;
}

.step-line {
  position: absolute;
  top: 24rpx;
  left: calc(50% + 32rpx);
  width: calc(100% - 64rpx);
  height: 2rpx;
  background: var(--color-border);
}

.step-item.done .step-line {
  background: var(--color-success);
}

.step-content {
  padding-bottom: 24rpx;
}

.form-tip {
  font-size: var(--font-xs);
  color: var(--color-text-light);
  margin-top: -8rpx;
}

/* 照片上传 */
.photo-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  position: relative;
  overflow: hidden;
}

.photo-preview-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 var(--radius-sm);
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon {
  font-size: 56rpx;
  color: var(--color-text-light);
  line-height: 1;
}

.photo-add-text {
  font-size: var(--font-xs);
  color: var(--color-text-light);
  margin-top: 8rpx;
}

/* 提交区 */
.submit-area {
  padding: 32rpx 24rpx;
}

/* 步骤底部 */
.step-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--color-bg-white);
  border-top: 1rpx solid var(--color-border-light);
  z-index: 100;
}

.search-placeholder {
  color: var(--color-text-placeholder);
  font-size: var(--font-md);
}

/* ---------- 2026-11-16 多产品登记 ---------- */
.section-tip {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
  line-height: 1.5;
}

.product-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.product-index {
  flex: 0 0 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #F5EDE9;
  color: #5C1A1A;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.product-input {
  flex: 1;
}

.product-remove {
  flex: 0 0 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  color: #BBBBBB;
  font-size: 26rpx;
}

.product-add {
  margin-top: 8rpx;
  padding: 22rpx 0;
  text-align: center;
  border: 1rpx dashed #D8C9C3;
  border-radius: 12rpx;
  color: #5C1A1A;
  font-size: 26rpx;
}

.mono {
  font-family: monospace;
  letter-spacing: 0.5rpx;
}

/* 2026-11-16 修 UI 挤压：带说明的 section-header 改纵向 */
.section-header.stacked {
  flex-direction: column;
  align-items: flex-start;
}
.section-header.stacked .section-tip {
  margin-top: 8rpx;
}

/* 质保码模糊查找下拉 */
.product-row-wrap {
  margin-bottom: 16rpx;
}
.product-row-wrap .product-row {
  margin-bottom: 0;
}
.suggest-list {
  margin: 6rpx 0 0 60rpx;
  border: 1rpx solid #E7DAD4;
  border-radius: 12rpx;
  background: #FFFFFF;
  overflow: hidden;
}
.suggest-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #F5EDE9;
}
.suggest-item:last-child {
  border-bottom: none;
}
.suggest-code {
  font-size: 26rpx;
  font-family: monospace;
  color: #1A1412;
}
.suggest-model {
  font-size: 22rpx;
  color: #999999;
  margin-left: 16rpx;
}

/* 2026-11-16 放宽间距（用户反馈拥挤） */
.product-row-wrap {
  margin-bottom: 28rpx;
}
.product-row-wrap:last-of-type {
  margin-bottom: 16rpx;
}

/* 产品识别结果 */
.product-model {
  margin: 10rpx 0 0 60rpx;
  font-size: 24rpx;
  color: #1F6B45;
}
.product-model-bad {
  color: #C0392B;
}

/* 「＋ 再添加一个产品」与下方说明之间留出呼吸感 */
.product-add {
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}
.product-row-wrap + .product-add {
  margin-top: 4rpx;
}

.suggest-hint {
  margin: 10rpx 0 0 60rpx;
  font-size: 24rpx;
  color: #8C817D;
}
