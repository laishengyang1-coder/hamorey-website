/* 门店积分页 */

.page-container {
  min-height: 100vh;
  background: #FEFAF8;
  padding-bottom: 120rpx;
}

/* 红色头部 */
.points-hero {
  background: linear-gradient(135deg, #5C1A1A, #7A2828);
  padding: 32rpx 32rpx;
  color: #FFFFFF;
}

.points-hero-balance { text-align: center; margin-bottom: 24rpx; }

.points-hero-label { font-size: 24rpx; color: rgba(255,255,255,0.6); margin-bottom: 4rpx; }

.points-hero-value { font-size: 72rpx; font-weight: 700; line-height: 1; }

.points-hero-row { display: flex; justify-content: space-around; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,0.15); }

.points-hero-item { text-align: center; }

.points-hero-item-label { font-size: 20rpx; color: rgba(255,255,255,0.5); display: block; margin-bottom: 2rpx; }

.points-hero-item-value { font-size: 28rpx; font-weight: 600; }

/* 快捷入口 */
.quick-row { display: flex; gap: 16rpx; margin: 24rpx; }

.quick-btn {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 24rpx; background: #FFFFFF; border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.quick-btn-icon { font-size: 40rpx; margin-bottom: 8rpx; }

.quick-btn-text { font-size: 24rpx; color: #1A1412; }

/* 流水 */
.section { padding: 0 24rpx; }

.section-header { margin-bottom: 12rpx; }

.section-title { font-size: 30rpx; font-weight: 700; color: #1A1412; }

.section-body { background: #FFFFFF; border-radius: 16rpx; padding: 0 24rpx; }

.ledger-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 1rpx solid #F0EBE7;
}

.ledger-item:last-child { border-bottom: none; }

.ledger-info { flex: 1; }

.ledger-desc { font-size: 26rpx; color: #1A1412; margin-bottom: 4rpx; }

.ledger-time { font-size: 20rpx; color: #9E8A82; }

.ledger-amount { font-size: 28rpx; font-weight: 600; color: #1A1412; }

.text-success { color: #34A853; }

/* Loading */
.loading-container, .empty-state { padding: 80rpx; text-align: center; }

.loading-spinner {
  width: 48rpx; height: 48rpx; border: 4rpx solid #E8E0DC;
  border-top-color: #5C1A1A; border-radius: 50%;
  animation: spin .8s linear infinite; margin: 0 auto;
}
@keyframes spin { to { transform: rotate(360deg); } }

.empty-state-text { font-size: 26rpx; color: #9E8A82; }
