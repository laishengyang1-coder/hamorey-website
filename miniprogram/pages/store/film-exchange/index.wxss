.page-container {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 180rpx;
}

/* 顶部说明 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 0;
}

.page-header-tip {
  font-size: var(--font-sm);
  color: var(--color-text-light);
}

.page-header-link {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: 500;
}

/* 查询行 */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
}

.search-btn {
  width: 160rpx;
  flex-shrink: 0;
}

.search-placeholder {
  color: var(--color-text-placeholder);
  font-size: var(--font-md);
}

/* 查询结果 */
.lookup-empty {
  padding: 48rpx 0 24rpx;
  text-align: center;
}

.lookup-list {
  margin-top: 24rpx;
}

.lookup-card {
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.lookup-card.selected {
  border-color: var(--color-primary);
  background: rgba(92, 26, 26, 0.04);
}

.lookup-card.disabled {
  opacity: 0.55;
}

.lookup-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.lookup-plate {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.lookup-name {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.lookup-meta {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-xs);
  color: var(--color-text-light);
}

.lookup-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border);
  flex-shrink: 0;
}

.lookup-radio.checked {
  border-color: var(--color-primary);
  background: var(--color-primary);
  box-shadow: inset 0 0 0 6rpx #FFFFFF;
}

/* 选中膜信息条 */
.selected-bar {
  display: flex;
  align-items: center;
  margin: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(92, 26, 26, 0.06);
  border-radius: var(--radius-md);
}

.selected-bar-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.selected-bar-value {
  font-size: var(--font-md);
  color: var(--color-primary);
  font-weight: 600;
}

.section-count {
  font-size: var(--font-sm);
  color: var(--color-text-light);
}

/* 照片/视频上传 */
.photo-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  position: relative;
  overflow: hidden;
  background: var(--color-bg-card);
}

.photo-preview-img {
  width: 100%;
  height: 100%;
}

.video-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--color-text-light);
}

.video-badge {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 12rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: var(--radius-round);
}

.photo-uploading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.4);
  color: #FFFFFF;
  font-size: var(--font-xs);
}

.photo-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 var(--radius-sm);
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon {
  font-size: 56rpx;
  color: var(--color-text-light);
  line-height: 1;
}

.photo-add-text {
  font-size: var(--font-xs);
  color: var(--color-text-light);
  margin-top: 8rpx;
}

/* 提交栏 */
.submit-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: var(--color-bg-white);
  border-top: 1rpx solid var(--color-border-light);
  z-index: 100;
}
