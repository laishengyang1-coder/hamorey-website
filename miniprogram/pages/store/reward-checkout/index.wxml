<view class="checkout-page">
  <scroll-view scroll-y="true" class="checkout-scroll">
    <!-- 订单商品 -->
    <view class="order-list">
      <view class="order-item" wx:for="{{items}}" wx:key="id">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="order-img" />
        <view wx:else class="order-img-fb">🎁</view>
        <view class="order-info">
          <view class="order-name">{{item.name}}</view>
          <view class="order-qty">×{{item.qty}}</view>
        </view>
        <view class="order-subtotal">{{item.points * item.qty}} 积分</view>
      </view>
    </view>

    <!-- 收货地址 -->
    <view class="card-section">
      <view class="card-title">收货地址</view>

      <!-- 已有地址列表 -->
      <view class="addr-item {{item.id === selectedAddressId ? 'active' : ''}}" wx:for="{{addresses}}" wx:key="id" data-id="{{item.id}}" bindtap="tapAddress">
        <view class="addr-radio">
          <view class="addr-radio-dot" wx:if="{{item.id === selectedAddressId}}"></view>
        </view>
        <view class="addr-main">
          <view class="addr-line1">
            <text class="addr-name">{{item.recipient_name}}</text>
            <text class="addr-phone">{{item.phone}}</text>
            <text class="addr-default" wx:if="{{item.is_default}}">默认</text>
          </view>
          <view class="addr-line2">{{item.province}} {{item.city}} {{item.district || ''}} {{item.detail_address}}</view>
        </view>
      </view>

      <view class="addr-empty" wx:if="{{addresses.length === 0}}">暂无收货地址，请先新增</view>

      <!-- 新增地址表单 -->
      <view class="addr-add-btn" bindtap="toggleAddrForm">{{showAddrForm ? '收起新增' : '+ 新增收货地址'}}</view>

      <block wx:if="{{showAddrForm}}">
        <view class="addr-form">
          <view class="addr-row">
            <view class="addr-cell"><input placeholder="收货人姓名" value="{{newAddr.name}}" data-field="name" bindinput="onAddrFormInput" /></view>
            <view class="addr-cell"><input placeholder="手机号" type="number" maxlength="11" value="{{newAddr.phone}}" data-field="phone" bindinput="onAddrFormInput" /></view>
          </view>
          <view class="addr-row">
            <view class="addr-cell"><input placeholder="省份（如：河北省）" value="{{newAddr.province}}" data-field="province" bindinput="onAddrFormInput" /></view>
            <view class="addr-cell"><input placeholder="城市（如：廊坊市）" value="{{newAddr.city}}" data-field="city" bindinput="onAddrFormInput" /></view>
          </view>
          <view class="addr-cell-full"><input placeholder="区县（选填，如：广阳区）" value="{{newAddr.district}}" data-field="district" bindinput="onAddrFormInput" /></view>
          <view class="addr-cell-full"><input placeholder="详细地址（如：XX路XX号XX室）" value="{{newAddr.detail}}" data-field="detail" bindinput="onAddrFormInput" /></view>
          <view class="addr-default-row">
            <text class="addr-default-label">设为默认地址</text>
            <switch checked="{{newAddr.isDefault}}" bindchange="onDefaultChange" color="#5C1A1A" />
          </view>
          <view class="addr-save-btn {{savingAddr ? 'disabled' : ''}}" bindtap="saveAddress">{{savingAddr ? '保存中...' : '保存地址'}}</view>
        </view>
      </block>
    </view>

    <!-- 汇总 -->
    <view class="card-section">
      <view class="card-title">积分汇总</view>
      <view class="summary-row">
        <text class="summary-label">商品合计</text>
        <text class="summary-value">{{total}} 积分</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-row total">
        <text class="summary-label">应付积分</text>
        <text class="summary-total">{{total}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 提交 -->
  <view class="submit-area">
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
      {{submitting ? '提交中...' : '确认兑换'}}
    </view>
  </view>
</view>
