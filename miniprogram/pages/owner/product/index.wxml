<view class="product-page">
  <!-- 系列 Tab -->
  <scroll-view class="series-tab-bar" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="series-tab {{activeSeries === item.key ? 'active' : ''}}" wx:for="{{seriesList}}" wx:key="key" data-key="{{item.key}}" bindtap="switchSeries">
      <text>{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 系列 Hero -->
  <view class="series-hero">
    <image class="series-hero-img" src="{{activeData.image}}" mode="aspectFill" />
    <view class="series-hero-overlay"></view>
    <view class="series-hero-content">
      <view class="series-hero-title">{{activeData.label}}</view>
      <view class="series-hero-en">{{activeData.en}}</view>
      <view class="series-hero-desc">{{activeData.desc}}</view>
    </view>
  </view>

  <!-- 产品列表 -->
  <view class="product-list">
    <view class="product-card" wx:for="{{activeData.products}}" wx:key="code">
      <view class="product-card-header">
        <view class="product-card-title-area">
          <view class="product-name">{{item.name}}</view>
          <view class="product-en">{{item.en}}</view>
        </view>
        <view class="product-warranty-badge">{{item.warranty}}年质保</view>
      </view>
      <view class="product-highlight">{{item.highlight}}</view>
      <view class="product-tech">{{item.tech}}</view>
      <view class="specs-grid">
        <view class="spec-item" wx:for="{{item.specs}}" wx:key="index">
          <view class="spec-dot"></view>
          <text class="spec-text">{{item}}</text>
        </view>
      </view>
      <view class="product-card-footer" wx:if="{{item.price}}">
        <view class="product-price">参考价 ¥{{item.price}}</view>
        <view class="product-quote-btn" bindtap="goQuote">查看报价</view>
      </view>
      <view class="product-card-footer" wx:else>
        <view class="product-price">询价请咨询门店</view>
        <view class="product-quote-btn" bindtap="goQuote">查看报价</view>
      </view>
    </view>
  </view>

  <!-- 底部 CTA -->
  <view class="bottom-cta">
    <view class="cta-btn cta-stores" bindtap="goStores">查找门店</view>
    <view class="cta-btn cta-quote" bindtap="goQuote">理赔报价</view>
  </view>

  <view class="safe-bottom"></view>
</view>
