/* 产品体系页 */

.product-page {
  min-height: 100vh;
  background: #FEFAF8;
  padding-bottom: 40rpx;
}

/* 系列 Tab */
.series-tab-bar {
  white-space: nowrap;
  padding: 16rpx 28rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0EBE7;
  position: sticky;
  top: 0;
  z-index: 10;
}

.series-tab {
  display: inline-block;
  padding: 14rpx 32rpx;
  margin-right: 12rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #4A3A34;
  background: #F5F0EB;
  font-weight: 500;
}

.series-tab.active {
  background: #5C1A1A;
  color: #FFFFFF;
  font-weight: 600;
}

/* 系列 Hero */
.series-hero {
  position: relative;
  height: 280rpx;
  overflow: hidden;
}

.series-hero-img {
  width: 100%;
  height: 100%;
}

.series-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(transparent 30%, rgba(26,20,18,0.75));
}

.series-hero-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 28rpx;
}

.series-hero-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.series-hero-en {
  font-size: 20rpx;
  color: rgba(255,255,255,0.55);
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.series-hero-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.5;
}

/* 产品列表 */
.product-list {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #EDE6E2;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.product-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.product-card-title-area {
  flex: 1;
}

.product-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1412;
  margin-bottom: 2rpx;
}

.product-en {
  font-size: 20rpx;
  color: #9E8A82;
  letter-spacing: 2rpx;
}

.product-warranty-badge {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #5C1A1A, #7A2828);
  color: #C8A96E;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.product-highlight {
  font-size: 26rpx;
  font-weight: 600;
  color: #5C1A1A;
  margin-bottom: 4rpx;
}

.product-tech {
  font-size: 22rpx;
  color: #7A6A62;
  margin-bottom: 16rpx;
}

/* 参数 */
.specs-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.spec-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #F9F5F2;
  border-radius: 24rpx;
}

.spec-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #C8A96E;
}

.spec-text {
  font-size: 22rpx;
  color: #4A3A34;
}

/* 底部 */
.product-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EBE7;
}

.product-price {
  font-size: 24rpx;
  color: #C8A96E;
  font-weight: 600;
}

.product-quote-btn {
  padding: 10rpx 28rpx;
  background: #5C1A1A;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 24rpx;
}

/* 底部 CTA */
.bottom-cta {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}

.cta-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.cta-stores {
  background: #F5F0EB;
  color: #5C1A1A;
  border: 1rpx solid #E0D5CE;
}

.cta-quote {
  background: #5C1A1A;
  color: #FFFFFF;
}

.safe-bottom { height: 40rpx; }
