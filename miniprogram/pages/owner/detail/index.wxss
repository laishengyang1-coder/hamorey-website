/* 电子质保卡详情 — 友商式长图版式（红色暖白主题） */

.detail-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.detail-scroll {
  height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 加载 / 错误 */
.loading-container, .error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 32rpx;
}

.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 3rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.loading-text { font-size: 28rpx; color: var(--color-text-secondary); }
.error-text { font-size: 28rpx; color: var(--color-text-secondary); margin-bottom: 24rpx; }

.retry-btn {
  padding: 16rpx 48rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-round);
  font-size: 28rpx;
}

/* 证书卡 */
.cert-card {
  margin: 24rpx 24rpx 0;
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(92, 26, 26, 0.08);
}

/* 品牌头 */
.cert-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 32rpx 36rpx;
  background: var(--color-primary);
}

.header-left { flex: 1; min-width: 0; }

.brand-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.warranty-en {
  font-size: 18rpx;
  color: #C8A96E;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.cert-status {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-round);
  font-size: 22rpx;
  font-weight: 600;
}

.tag-success {
  background: rgba(200, 169, 110, 0.22);
  color: #C8A96E;
  border: 1rpx solid rgba(200, 169, 110, 0.35);
}

/* 产品卡 */
.product-card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.product-info { flex: 1; min-width: 0; }

.product-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.product-model {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.product-cert {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
}

.product-cert-label {
  font-size: 18rpx;
  color: var(--color-text-light);
}

.product-cert-no {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* 信息分组 */
.info-group {
  margin: 28rpx 24rpx 0;
}

.group-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 14rpx;
}

.group-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.group-note {
  font-size: 18rpx;
  color: var(--color-text-light);
}

.info-card {
  background: var(--color-bg-white);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  padding: 4rpx 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 24rpx;
  color: var(--color-text-light);
  flex-shrink: 0;
  width: 150rpx;
}

.info-value {
  font-size: 24rpx;
  color: var(--color-text);
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
  word-break: break-all;
}

/* 部位价值参考表 */
.part-table {
  display: flex;
  background: var(--color-bg-white);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.part-col {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.part-col + .part-col {
  border-left: 1rpx solid var(--color-border-light);
}

.part-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.part-row:last-child {
  border-bottom: none;
}

.part-head {
  border-bottom: 1rpx solid var(--color-border);
}

.part-name {
  font-size: 22rpx;
  color: var(--color-text);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.part-price {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.part-head .part-name, .part-head .part-price {
  font-weight: 700;
  color: var(--color-primary);
}

/* 质保须知 / 除外情形 */
.notice-card {
  background: var(--color-bg-white);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
}

.notice-line {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.notice-line:last-child {
  margin-bottom: 0;
}

/* 底部品牌条 */
.cert-footer {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  background: var(--color-primary);
  text-align: center;
}

.footer-brand {
  font-size: 20rpx;
  color: #C8A96E;
}

/* 电子证书下载按钮 */
.cert-download-btn {
  margin: 28rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #5C1A1A 0%, #7A2E2E 100%);
  border-radius: var(--radius-md);
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(92, 26, 26, 0.25);
}

.cert-download-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.cert-download-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.cert-download-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cert-download-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.cert-download-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cert-download-btn .arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.arrow { font-size: 32rpx; }

.safe-bottom { height: 40rpx; }
