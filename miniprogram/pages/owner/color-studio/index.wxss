page {
  background: #141414;
  color: #f7f5ef;
}
.error {
  padding: 160rpx 48rpx 64rpx;
  text-align: center;
}
.title, .description {
  display: block;
}
.title {
  font-size: 38rpx;
  font-weight: 600;
}
.description {
  margin: 24rpx 0 48rpx;
  color: #c6c3bd;
  font-size: 28rpx;
  line-height: 1.7;
}
.retry, .copy {
  margin: 20rpx auto;
  font-size: 30rpx;
  border-radius: 12rpx;
}
.retry {
  background: #d5ba83;
  color: #211b13;
}
.copy {
  background: transparent;
  color: #e2c895;
}
.copy::after {
  border-color: #736348;
}
