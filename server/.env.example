NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://system.hemoppf.cn,https://www.hemoppf.cn
SITE_URL=https://system.hemoppf.cn
BRAND_NAME=HAMOREY
# The Tencent Nginx reverse proxy is one trusted hop in production.
TRUST_PROXY_HOPS=1
# Failed login attempts allowed per IP before a temporary 429 response.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=hamorey
MYSQL_PASSWORD=
MYSQL_DATABASE=hamorey
MYSQL_CONNECTION_LIMIT=10

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
R2_PUBLIC_BASE_URL=

# 短信通知：质保审核通过后给车主发送「质保激活通知」
# 注意：COS_SECRET_ID/KEY 属于仅授 COS 权限的子账号，调短信接口会被 CAM 拒绝
# （AuthFailure.UnauthorizedOperation），必须单独提供具备 sms:SendSms 权限的密钥。
# 未配置时静默跳过发送，只记日志，不影响审核流程。
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=HAMOREY和膜
SMS_TEMPLATE_ID=2710739
SMS_REGION=ap-guangzhou
